# Copy to .env.local for local development. Set the real values in
# Vercel > Project > Settings > Environment Variables. Never commit real values.

# Anthropic API key used by /api/match
ANTHROPIC_API_KEY=

# Admin login (server-side only; do NOT prefix these with NEXT_PUBLIC_)
# ADMIN_PASSWORD: at least 12 characters.
# ADMIN_SESSION_SECRET: at least 32 random characters, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Upstash Redis. Vercel sets one of these pairs automatically when the store
# is connected to the project; either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Models and effort used by Skylar. Leave these unset to keep the
# defaults (claude-sonnet-4-6 for Career Match, claude-haiku-4-5-20251001 for
# the guides). Change them on Preview first and compare the timings in Admin.
# SKYLAR_MATCH_MODEL=
# SKYLAR_DETAIL_MODEL=
# SKYLAR_GUIDE_MODEL=
# SKYLAR_MATCH_EFFORT=medium
# SKYLAR_DETAIL_EFFORT=medium
# SKYLAR_GUIDE_EFFORT=low
